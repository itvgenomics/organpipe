# Job scripts and their outputs
*.pbs
*.slurm
slurm-*.out
/*.o[0-9]*
/*.e[0-9]*
nohup.out
/*.log
changelog.txt

# Configuration files of your own runs (the templates are in config/ and test_data/)
/config_*.csv
/config_*.yaml

# Generated by every run
.snakemake/
/benchmarks/
/logs/
/results/
/singularity/
/tmp/
workflow/reports/
config/snakemake_config.yaml
profiles/*/config.yaml

# Downloaded or built by the run: everything in resources/ except what ships with OrganPipe
resources/*/
!resources/refseq89m/
resources/nhmmer_db.hmm*
resources/table2asn.linux64
*.sif
*.sif.partial

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*:Zone.Identifier
